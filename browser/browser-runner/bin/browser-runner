#!/bin/bash
# browser-runner 全局入口（跟着 skill 走）——解析带 playwright 的 python + 调 core/runner.py。
# 无参数 → runner 默认开可视化看板。
#
# python 解析优先级：$BROWSER_RUNNER_PYTHON > skill 内 .venv > ~/.venvs/current > python3
# 兼容 macOS 自带 bash 3.2。
set -o pipefail

# 解析本脚本真实路径（跟随软链，因 skill 会被 symlink 到 ~/.claude/skills 等处）
SELF="${BASH_SOURCE[0]:-$0}"
while [ -h "$SELF" ]; do
  d=$(cd -P "$(dirname "$SELF")" >/dev/null 2>&1 && pwd)
  SELF=$(readlink "$SELF")
  case "$SELF" in /*) ;; *) SELF="$d/$SELF" ;; esac
done
SKILL_DIR=$(cd -P "$(dirname "$SELF")/.." >/dev/null 2>&1 && pwd)   # bin/ 的上一层 = skill 根

PY="${BROWSER_RUNNER_PYTHON:-}"
if [ -z "${PY}" ]; then
  if [ -x "${SKILL_DIR}/.venv/bin/python" ]; then PY="${SKILL_DIR}/.venv/bin/python"
  elif [ -x "${HOME}/.venvs/current/bin/python" ]; then PY="${HOME}/.venvs/current/bin/python"
  else PY="python3"; fi
fi

exec "${PY}" "${SKILL_DIR}/core/runner.py" "$@"
